
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f6fa;
    color: #263238;
    line-height: 1.6;
}

/* Header */

.header {
    background: #17365d;
    color: white;
    padding: 18px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

.header h1 {
    font-size: 22px;
}

.header p {
    font-size: 13px;
    color: #dce6f1;
}

/* Navigation */

.navbar {
    background: #ffffff;
    padding: 12px 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    border-bottom: 1px solid #ddd;
}

.navbar a {
    text-decoration: none;
    color: #17365d;
    padding: 9px 15px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 14px;
}

.navbar a:hover,
.navbar a.active {
    background: #17365d;
    color: white;
}

/* Main content */

.container {
    max-width: 1200px;
    width: 94%;
    margin: 30px auto;
    min-height: 65vh;
}

.page-title {
    font-size: 25px;
    color: #17365d;
    margin-bottom: 20px;
}

/* Dashboard cards */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.stat-card {
    background: white;
    padding: 22px;
    border-radius: 9px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    border-left: 5px solid #2874a6;
}

.stat-card h3 {
    font-size: 14px;
    color: #777;
}

.stat-card p {
    font-size: 27px;
    font-weight: bold;
    color: #17365d;
    margin-top: 8px;
}

/* Tables */

.table-wrapper {
    background: white;
    overflow-x: auto;
    border-radius: 8px;
    padding: 15px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
}

th, td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #e5e5e5;
}

th {
    background: #17365d;
    color: white;
}

tr:hover {
    background: #f5f8fc;
}

/* Forms */

.form-card {
    background: white;
    padding: 25px;
    border-radius: 9px;
    max-width: 700px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.form-group {
    margin-bottom: 17px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 14px;
}

.form-group input:focus,
.form-group select:focus {
    outline: 2px solid #2874a6;
    border-color: #2874a6;
}

/* Buttons */

.btn {
    display: inline-block;
    padding: 10px 16px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

.btn-primary {
    background: #17365d;
    color: white;
}

.btn-success {
    background: #218838;
    color: white;
}

.btn-danger {
    background: #dc3545;
    color: white;
}

.btn-warning {
    background: #ffc107;
    color: #222;
}

.btn:hover {
    opacity: 0.85;
}

/* Search */

.search-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.search-bar input,
.search-bar select {
    padding: 11px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Messages */

.alert {
    padding: 13px;
    margin-bottom: 18px;
    border-radius: 5px;
}

.alert-success {
    background: #d4edda;
    color: #155724;
}

.alert-error {
    background: #f8d7da;
    color: #721c24;
}

/* Status labels */

.status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 15px;
    font-size: 12px;
    font-weight: bold;
}

.status-returned {
    background: #d4edda;
    color: #155724;
}

.status-borrowed {
    background: #fff3cd;
    color: #856404;
}

.status-overdue {
    background: #f8d7da;
    color: #721c24;
}

/* Footer */

.footer {
    background: #17365d;
    color: white;
    padding: 18px;
    text-align: center;
    margin-top: 35px;
    font-size: 13px;
}

/* Login page */

.login-container {
    max-width: 420px;
    margin: 65px auto;
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}

.login-container h2 {
    text-align: center;
    color: #17365d;
    margin-bottom: 20px;
}

/* Responsive design */

@media (max-width: 900px) {
    .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    .header {
        padding: 16px;
    }

    .navbar {
        padding: 10px;
        gap: 5px;
    }

    .navbar a {
        font-size: 12px;
        padding: 8px;
    }

    .container {
        width: 95%;
        margin: 20px auto;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .page-title {
        font-size: 21px;
    }

    .login-container {
        margin: 30px 15px;
    }
}
